# ---------------------------------------------------------------------------
# JobScout configuration. Copy to .env and adjust.
# Every variable is read through pydantic-settings (JOBSCOUT_ prefix).
# ---------------------------------------------------------------------------

# --- storage ---------------------------------------------------------------
# Async driver (used by the app). `alembic` derives the sync URL from this.
JOBSCOUT_DATABASE_URL=postgresql+asyncpg://jobscout:jobscout@localhost:5432/jobscout
# Optional explicit sync URL for migrations. Auto-derived when unset.
# JOBSCOUT_DATABASE_URL_SYNC=postgresql+psycopg://jobscout:jobscout@localhost:5432/jobscout

# --- crawl politeness ------------------------------------------------------
JOBSCOUT_USER_AGENT=JobScoutBot/0.1 (+https://github.com/your-handle/jobscout; contact@example.com)
JOBSCOUT_RESPECT_ROBOTS=true
JOBSCOUT_GLOBAL_CONCURRENCY=8
JOBSCOUT_PER_DOMAIN_CONCURRENCY=2
JOBSCOUT_PER_DOMAIN_RATE=1.0
JOBSCOUT_REQUEST_TIMEOUT=20.0
JOBSCOUT_CONNECT_TIMEOUT=10.0
JOBSCOUT_MAX_RETRIES=4
JOBSCOUT_BACKOFF_BASE=0.5
JOBSCOUT_BACKOFF_CAP=30.0
JOBSCOUT_CIRCUIT_FAILURE_THRESHOLD=8
JOBSCOUT_CIRCUIT_RESET_SECONDS=60.0
JOBSCOUT_CRAWL_DELAY_FALLBACK=1.0
JOBSCOUT_MAX_DEPTH=2
JOBSCOUT_MAX_PAGES=200

# --- storage of raw responses ---------------------------------------------
# Keep gzipped HTML/JSON snapshots so parsers can be re-run without re-crawling.
JOBSCOUT_STORE_SNAPSHOTS=true
JOBSCOUT_SNAPSHOT_MAX_BYTES=4194304

# --- API / dashboard -------------------------------------------------------
JOBSCOUT_METRICS_ENABLED=true
JOBSCOUT_API_TITLE=JobScout API
JOBSCOUT_DASHBOARD_API_URL=http://localhost:8000

# --- logging ---------------------------------------------------------------
JOBSCOUT_LOG_LEVEL=INFO
JOBSCOUT_LOG_FORMAT=json

# --- tests -----------------------------------------------------------------
JOBSCOUT_TEST_DATABASE_URL=postgresql+asyncpg://jobscout:jobscout@localhost:5432/jobscout_test
