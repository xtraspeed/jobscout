# Build context exclusions. Keep the image small and avoid baking local state
# (databases, venvs, recorded fixtures) into it.

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local state
.env
.env.*
!.env.example
*.db
*.sqlite3
data/
artifacts/
var/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# VCS and editors
.git/
.github/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docs and local notes are not needed at runtime
*.md
!README.md
